<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add new post</title>
    <link rel="stylesheet" href="/style.css">
  </head>

  <body>

     <h1 class="title">Quora post</h1>
    <form method="post" action="/posts">
      <input class="newUser" type="text" placeholder="Enter Username" name="username" />
      <br />
      <br />
      <textarea class="newContent" rows="10" cols="35" name="content" placeholder="write your content here"></textarea>
      <br />

      <button class="submit">submit</button>
    </form>


  </body>
</html>
