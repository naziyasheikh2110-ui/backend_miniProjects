<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1 class="title">Quora post</h1>
    <div class="posts">
        <%for(post of posts){%>
            <div class="post">

                <h3 class="user">@<%= post.username %>
                </h3>
                <h4 class="content">
                    <%= post.content %>
                </h4>
                <br>
                <a class="show" href="http://localhost:8080/posts/<%=post.id %> ">See Post in detail</a>

                <br>
                <a class="edit"  href="http://localhost:8080/posts/<%=post.id %>/edit">Edit Post</a>
                <br>
                <form method="post" action="/posts/<%=post.id%>?_method=DELETE"> <button class="delete">Delete Post</button></form>

            </div>
            <% } %>
    </div>
    <br>
    <br>

    <a  class="new" href="http://localhost:8080/posts/new">Creat a new Post</a>

</body>

</html>